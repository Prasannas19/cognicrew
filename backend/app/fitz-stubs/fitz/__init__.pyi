import os
from _typeshed import SupportsDunderLT, SupportsRichComparison
from typing import Any, BinaryIO, Literal, Sequence, overload
from typing_extensions import Never  # noqa: F401

class Rect:
    x0: float
    y0: float
    x1: float
    y1: float
    def __init__(self, x0: float, y0: float, x1: float, y1: float) -> None: ...

class Document:
    page_count: int
    metadata: dict[str, Any] | None
    is_closed: bool
    def __init__(self) -> None: ...
    def new_page(self, pno: int = -1, width: float = 595, height: float = 842) -> Page: ...
    @overload
    def __getitem__(self, idx: int) -> Page: ...
    @overload
    def __getitem__(self, idx: slice) -> list[Page]: ...
    def __len__(self) -> int: ...
    def __iter__(self): ...
    def __enter__(self) -> Document: ...
    def __exit__(self, *exc: object) -> None: ...
    def close(self) -> None: ...
    def tobytes(self, garbage: int = 0, clean: bool = False, deflate: bool = False) -> bytes: ...
    def save(self, filename: str | os.PathLike[str], garbage: int = 0, clean: bool = False, deflate: bool = False) -> None: ...
    def load_page(self, pno: int) -> Page: ...

class Page:
    number: int
    rect: Rect
    def get_text(self, option: str = "text", clip: Rect | None = None) -> Any: ...
    def insert_text(self, point: tuple[float, float], text: str, fontsize: float = 11, fontname: str = "helv", color: tuple[float, ...] | None = None) -> int: ...
    def insert_textbox(self, rect: Rect, text: str, fontsize: float = 11, fontname: str = "helv", color: tuple[float, ...] | None = None, align: int = 0) -> int: ...
    def close(self) -> None: ...

def open(*args: Any, **kwargs: Any) -> Document: ...
def open_stream(stream: bytes, filetype: str = "pdf") -> Document: ...
